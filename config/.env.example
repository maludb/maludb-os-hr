# HR — environment config. Copy to config/.env (640, group www-data). NEVER commit the real .env.
# The installation agent writes every key here at install (maludb-os.json, env.required).

APP_ENV=prod
APP_DEBUG=0
APP_NAME="HR"
APP_URL=https://hr.example.com
APP_KEY=hr                      # this application's catalog_key: the audience of every token it accepts

# --- PostgreSQL: the application's own database (db/001 creates the three roles) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_hr
DB_USER=hr_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=hr_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=hr_activity_ro
MCP_ACTIVITY_DB_PASSWORD=

# --- Ports (assigned by the installation agent; the kernel owns 8080 and 8811-8816) ---
APP_INTERNAL_PORT=8180          # PHP on loopback, for the kernel's actions server and approval replays
MCP_RECORDS_PORT=8821
MCP_ACTIVITY_PORT=8822

# --- The tenant's keys, copied from the kernel's config/.env: one run token and one hand-off token valid everywhere ---
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=

# --- The kernel ---
OS_APPLICATION_TOKEN=           # minted on HR's Overview in the kernel; the bearer for directory, ledger and chat
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/

# --- The tenant's one memory (MaluDB) ---
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=

# --- Optional ---
MALUMAIL_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="HR"
API_CORS_ORIGINS=

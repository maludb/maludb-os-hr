[Unit]
Description=HR records MCP server (FastMCP, loopback :8821)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/apps/hr/mcp
ExecStart=/srv/apps/hr/mcp/venv/bin/python /srv/apps/hr/mcp/records_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
